# Private key of the relayer wallet (pays gas for Safe deployment on testnet)
# Fund this address with Arbitrum Sepolia ETH from: https://www.alchemy.com/faucets/arbitrum-sepolia
RELAYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Optional: Alchemy RPC (leave blank to use public Arbitrum Sepolia RPC)
ALCHEMY_RPC_URL=

# Server port
PORT=3001
